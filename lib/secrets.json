{
    "file": "secrets.yaml",
    "description": "Common files used to store secrets",
    "author": "Richard A. Dubniczky",
    "items": [
        {
            "name": "Environment variables",
            "type": "ini",
            "glob": [
                "**/.env*"
            ]
        },
        {
            "name": "Generic files named secret",
            "type": "any",
            "glob": [
                "**/secret*"
            ]
        },
        {
            "name": "Generic files named credential",
            "type": "any",
            "glob": [
                "**/credential*"
            ]
        },
        {
            "name": "Generic JSON config",
            "type": "json",
            "glob": [
                "**/config.json",
                "**/settings.json"
            ]
        },
        {
            "name": "PHP Files with secrets",
            "type": "php",
            "glob": [
                "**/config.php",
                "**/configuration.php",
                "**/settings.php"
            ]
        },
        {
            "name": "WordPress",
            "type": "php",
            "glob": [
                "**/wp-config.php"
            ]
        },
        {
            "name": "MediaWiki",
            "type": "php",
            "glob": [
                "**/LocalSettings.php"
            ]
        },
        {
            "name": ".NET",
            "type": "json",
            "glob": [
                "**/appsettings.json",
                "**/appsettings.*.json"
            ]
        },
        {
            "name": "IIS/.NET connection strings",
            "type": "xml",
            "glob": [
                "**/web.config",
                "**/app.config",
                "**/machine.config"
            ]
        },
        {
            "name": "Ruby on Rails",
            "type": "any",
            "glob": [
                "**/database.yml",
                "**/secrets.yml",
                "**/master.key",
                "**/credentials.yml.enc"
            ]
        },
        {
            "name": "Spring",
            "type": "yaml",
            "glob": [
                "**/application.properties",
                "**/application.yml"
            ]
        },
        {
            "name": "Django",
            "type": "py",
            "glob": [
                "**/local_settings.py",
                "**/settings.py"
            ]
        },
        {
            "name": "AWS",
            "type": "ini",
            "glob": [
                "**/.aws/credentials",
                "**/.aws/config"
            ]
        },
        {
            "name": "Azure",
            "type": "json",
            "glob": [
                "**/.azure/accessTokens.json",
                "**/.azure/msal_token_cache.json"
            ]
        },
        {
            "name": "Google Cloud",
            "type": "any",
            "glob": [
                "**/.config/gcloud/credentials.db",
                "**/application_default_credentials.json"
            ]
        },
        {
            "name": "Kubernetes",
            "type": "yaml",
            "glob": [
                "**/.kube/config"
            ]
        },
        {
            "name": "Docker",
            "type": "json",
            "glob": [
                "**/.docker/config.json"
            ]
        },
        {
            "name": "Terraform",
            "type": "any",
            "glob": [
                "**/terraform.tfstate",
                "**/terraform.tfvars",
                "**/*.auto.tfvars"
            ]
        },
        {
            "name": "Package manager credentials",
            "type": "any",
            "glob": [
                "**/.npmrc",
                "**/.pypirc",
                "**/.gem/credentials",
                "**/.m2/settings.xml"
            ]
        },
        {
            "name": "SSH keys",
            "type": "custom",
            "glob": [
                "**/.ssh/id_rsa*",
                "**/.ssh/id_ed25519*",
                "**/.ssh/id_ecdsa*",
                "**/.ssh/authorized_keys",
                "**/.ssh/known_hosts"
            ]
        },
        {
            "name": "Keys and certificates",
            "type": "any",
            "glob": [
                "**/*.pem",
                "**/*.key",
                "**/*.ppk",
                "**/*.pfx",
                "**/*.p12",
                "**/*.jks",
                "**/*.keystore"
            ]
        },
        {
            "name": "OpenVPN",
            "type": "custom",
            "glob": [
                "**/*.ovpn"
            ]
        },
        {
            "name": "Git",
            "type": "ini",
            "glob": [
                "**/.git/config",
                "**/.git-credentials",
                "**/.gitconfig"
            ]
        },
        {
            "name": "Netrc",
            "type": "custom",
            "glob": [
                "**/.netrc",
                "**/_netrc"
            ]
        },
        {
            "name": "Htpasswd",
            "type": "custom",
            "glob": [
                "**/.htpasswd"
            ]
        },
        {
            "name": "Shell and REPL history",
            "type": "txt",
            "glob": [
                "**/.bash_history",
                "**/.zsh_history",
                "**/.mysql_history",
                "**/.psql_history",
                "**/.python_history",
                "**/.viminfo",
                "**/PSReadLine/ConsoleHost_history.txt"
            ]
        },
        {
            "name": "Docker Compose and Dockerfile",
            "type": "yaml",
            "glob": [
                "**/docker-compose.yml",
                "**/Dockerfile"
            ]
        },
        {
            "name": "CI pipelines",
            "type": "yaml",
            "glob": [
                "**/.gitlab-ci.yml",
                "**/.github/workflows/*.yml",
                "**/Jenkinsfile"
            ]
        },
        {
            "name": "Jenkins",
            "type": "any",
            "glob": [
                "**/credentials.xml",
                "**/secrets/master.key",
                "**/secrets/hudson.util.Secret"
            ]
        },
        {
            "name": "Linux password files",
            "type": "custom",
            "glob": [
                "**/etc/shadow",
                "**/etc/passwd",
                "**/etc/security/opasswd"
            ]
        },
        {
            "name": "Mounts and Samba",
            "type": "ini",
            "glob": [
                "**/etc/fstab",
                "**/etc/samba/smb.conf",
                "**/.smbcredentials"
            ]
        },
        {
            "name": "Kerberos",
            "type": "any",
            "glob": [
                "**/etc/krb5.keytab",
                "**/tmp/krb5cc_*"
            ]
        },
        {
            "name": "Database credentials",
            "type": "any",
            "glob": [
                "**/mysql/mysql/user.MYD",
                "**/etc/mysql/debian.cnf",
                "**/.my.cnf",
                "**/.pgpass"
            ]
        },
        {
            "name": "Backup and swap files",
            "type": "any",
            "glob": [
                "**/*.bak",
                "**/*.old",
                "**/*.orig",
                "**/*.swp",
                "**/*~"
            ]
        },
        {
            "name": "KeePass",
            "type": "any",
            "glob": [
                "**/*.kdbx"
            ]
        },
        {
            "name": "FileZilla",
            "type": "xml",
            "glob": [
                "**/sitemanager.xml",
                "**/recentservers.xml"
            ]
        },
        {
            "name": "mRemoteNG",
            "type": "xml",
            "glob": [
                "**/confCons.xml"
            ]
        },
        {
            "name": "Browser saved logins",
            "type": "any",
            "glob": [
                "**/Login Data",
                "**/logins.json",
                "**/key4.db"
            ]
        }
    ]
}